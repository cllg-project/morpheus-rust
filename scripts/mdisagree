#!/usr/bin/env python3
"""
List lemma disagreements between C and Rust morpheus on the cached corpus sample.

Usage:
    ./scripts/mdisagree           # show all disagreements
    ./scripts/mdisagree word ...  # test specific words and show diff

Reads tests/corpus_sample.json (generated by sample_corpus.py / mcorpus).
"""
import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CORPUS_FILE = ROOT / "tests" / "corpus_sample.json"
RUST_BIN = ROOT / "target" / "release" / "morpheus"
STEMLIB = Path("~/dev/morpheus/stemlib").expanduser()

sys.path.insert(0, str(ROOT / "tests"))
from sample_corpus import c_lemma_set, rust_lemma_set


def load_disagree() -> list[dict]:
    with open(CORPUS_FILE) as f:
        records = json.load(f)
    result = []
    for r in records:
        if not r["c"] or not r["rust"]:
            continue
        c = c_lemma_set(r["c"])
        rust = rust_lemma_set(r["rust"])
        if not c & rust:
            result.append({
                "word": r["word"],
                "c_only": sorted(c - rust),
                "rust_only": sorted(rust - c),
            })
    return result


def test_word(word: str) -> dict | None:
    """Run Rust on a single word and return its lemma set."""
    result = subprocess.run(
        [str(RUST_BIN), "-m", str(STEMLIB), word],
        capture_output=True, text=True,
    )
    import re
    lemmas = set(re.findall(r'<hdwd[^>]*>([^<]+)</hdwd>', result.stdout))
    return lemmas


def main():
    args = sys.argv[1:]

    if args:
        # Per-word mode: show C (from cache) vs current Rust for each word
        with open(CORPUS_FILE) as f:
            records = json.load(f)
        by_word = {r["word"]: r for r in records}

        for word in args:
            rust_lemmas = test_word(word)
            if word in by_word:
                c = c_lemma_set(by_word[word]["c"])
            else:
                c = set()
            overlap = c & rust_lemmas
            status = "OK" if overlap else "DISAGREE"
            print(f"[{status}] {word}")
            if c:
                print(f"  C:    {sorted(c)}")
            print(f"  Rust: {sorted(rust_lemmas)}")
            if overlap:
                print(f"  Match on: {sorted(overlap)}")
        return

    # Default: show all corpus disagreements
    disagree = load_disagree()
    if not disagree:
        print("No disagreements — 100% lemma agreement.")
        return

    total = sum(1 for r in json.load(open(CORPUS_FILE)) if r["c"] and r["rust"])
    print(f"Lemma disagreements: {len(disagree)}/{total} "
          f"({100 * (total - len(disagree)) / total:.1f}% agreement)\n")

    for d in sorted(disagree, key=lambda x: x["word"]):
        print(f"  {d['word']}")
        print(f"    C:    {d['c_only']}")
        if d["rust_only"]:
            print(f"    Rust: {d['rust_only']}")


if __name__ == "__main__":
    main()
