#!/usr/bin/env bash
# mcorpus [--full]
# Run corpus test. Default: Rust-only refresh (fast, ~15s).
# --full: full regen including C run (~2min).
# Shows only the summary lines.

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

mode="--refresh-rust"
[[ "${1:-}" == "--full" ]] && mode=""

cd "$SCRIPT_DIR/.."
"$SCRIPT_DIR/../env/bin/python" tests/sample_corpus.py $mode 2>&1 \
  | grep -E 'found|Recall|Precision|Lemma|Missing|Re-running'
